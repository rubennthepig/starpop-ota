+#[test]
+fn starpop_current_art_quad_is_present_only_when_art_is_ready() {
+    let json = r##"{"home":[
+        {"type":"art","x":330,"y":80,"size":124,"source":"current","if":"has_art"}
+    ],"now_playing":[
+        {"type":"art","x":22,"y":60,"size":184,"source":"current"}
+    ]}"##;
+    let ui = skinned(compile_test(json).expect("art diagnostic layout compiles"));
+    let tracks = library(1);
+    let mut m = model(Screen::Home);
+    m.queue = tracks.clone();
+    m.queue_position = 0;
+    m.playback = PlaybackState::Playing;
+    for screen in [Screen::Home, Screen::NowPlaying] {
+        m.screen = screen;
+        let art = |ready| {
+            ui.draw(&m, &tracks, ready)
+                .iter()
+                .any(|q| q.tex == reborn_graphics::Tex::Art)
+        };
+        assert!(art(true), "current art quad missing on {screen:?}");
+        assert!(!art(false), "stale art quad on {screen:?}");
+    }
+}
