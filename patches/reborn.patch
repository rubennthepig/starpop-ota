+        .with("images/pink-star.png", b"65x64")
+        .with("images/cat.png", b"72x76")
+        .with("images/holo.png", b"32x31")
+        .with("images/sparkles.png", b"108x108")
+        .with("images/bears.png", b"61x64")
+        .with("images/stars.jpg", b"480x360")
+        .with("images/home-focus.png", b"298x38")
+        .with("images/progress.png", b"444x8");
+    let ui = skinned(compile("starpop-v13", manifest, &files).expect("Starpop v1.3 compiles"));
+    let tracks = library(1);
+    let mut m = model(Screen::Home);
+    m.queue = tracks.clone();
+    m.queue_position = 0;
+    m.playback = PlaybackState::Playing;
+    for screen in [Screen::Home, Screen::NowPlaying] {
+        m.screen = screen;
+        let quads = ui.draw(&m, &tracks, true);
+        let i = quads
+            .iter()
+            .position(|q| q.tex == reborn_graphics::Tex::Art)
+            .expect("ready cover must draw in the actual Starpop manifest");
+        let art = &quads[i];
+        assert!(
+            !quads[i + 1..]
+                .iter()
+                .any(|q| q.tex == reborn_graphics::Tex::Skin
+                    && q.x < art.x + art.w
+                    && q.x + q.w > art.x
+                    && q.y < art.y + art.h
+                    && q.y + q.h > art.y),
+            "later skin image overlaps cover on {screen:?}"
+        );
+    }
+}
diff --git a/crates/reborn-ui/src/starpop.rs b/crates/reborn-ui/src/starpop.rs
new file mode 100644
index 0000000..e039bf2
--- /dev/null
+++ b/crates/reborn-ui/src/starpop.rs
@@ -0,0 +1,154 @@
+//! Opt-in effects for the Starpop Arcade skin only.
+use crate::{canvas::Canvas, Ui};
+use reborn_graphics::{Quad, Tex};
+
+pub(crate) fn active(ui: &Ui) -> bool {
+    ui.skin
+        .as_ref()
+        .is_some_and(|s| s.name.to_ascii_lowercase().starts_with("starpop arcade"))
+}
+
+pub(crate) fn phase(ui: &Ui, live: bool) -> f32 {
+    if ui.ui_motion {
+        if live {
+            ui.mark_live();
+        }
+        crate::motion::phase(0.18) / std::f32::consts::TAU
+    } else {
+        0.
+    }
+}
+
+// Soft saturated rainbow, with a seamless cyclic hue.
+fn rainbow(h: f32, alpha: u32) -> u32 {
+    let h = h.rem_euclid(1.) * 6.;
+    let f = h.fract();
+    let (r, g, b) = match h.floor() as u32 {
+        0 => (1., f, 0.),
+        1 => (1. - f, 1., 0.),
+        2 => (0., 1., f),
+        3 => (0., 1. - f, 1.),
+        4 => (f, 0., 1.),
+        _ => (1., 0., 1. - f),
+    };
+    let v = |x: f32| (82. + 173. * x).round() as u32;
+    (v(r) << 24) | (v(g) << 16) | (v(b) << 8) | (alpha & 255)
+}
+
+// Sample a single horizontal hue field over the entire element. Each solid
+// piece has interpolated vertex colours; split only where the RGB slope
+// changes. Corner masks use the same field and retain their original UVs.
+pub(crate) fn gradient(c: &mut Canvas, start: usize, x: f32, _y: f32, w: f32, _h: f32, phase: f32) {
+    let old: Vec<Quad> = c.draw.drain(start..).collect();
+    for q in old {
+        gradient_quad(q, x, w, phase, &mut c.draw);
+    }
+}
+
+fn gradient_quad(q: Quad, x: f32, w: f32, phase: f32, out: &mut Vec<Quad>) {
+    if q.w <= 0. || q.h <= 0. || !matches!(q.tex, Tex::Solid | Tex::Mask) {
+        out.push(q);
+        return;
+    }
+    let w = w.max(1.);
+    let phase = phase.rem_euclid(1.);
+    let hue = |px: f32| phase + (px - x) / w;
+    let alpha = q.color & 255;
+    let tint = |px: f32| rainbow(hue(px), alpha);
+    let masked = q.tex == Tex::Mask;
+    let n = f32::from(q.src[2]);
+    // Work in local fractions; snapping masked cuts to original texel
+    // boundaries keeps the coverage atlas sampling continuous.
+    let mut cuts = vec![0.];
+    let first = (hue(q.x) * 6.).floor() as i32 + 1;
+    let last = (hue(q.x + q.w) * 6.).ceil() as i32;
+    for k in first..last {
+        let pos = x + (k as f32 / 6. - phase) * w;
+        let mut t = (pos - q.x) / q.w;
+        if masked && n > 0. {
+            t = (t * n).round() / n;
+        }
+        if t > *cuts.last().unwrap() + 0.00001 && t < 1. - 0.00001 {
+            cuts.push(t);
+        }
+    }
+    cuts.push(1.);
+    for (i, pair) in cuts.windows(2).enumerate() {
+        let (a, b) = (pair[0], pair[1]);
+        let left = q.x + q.w * a;
+        let right = q.x + q.w * b;
+        let mut p = q.clone();
+        p.x = left;
+        p.w = right - left;
+        if masked && n > 0. {
+            let lo = (a * n).round() as u16;
+            let hi = (b * n).round() as u16;
+            p.src[0] += lo;
+            p.src[2] = hi - lo;
+        }
+        let l = tint(left);
+        let r = tint(right);
+        p.color = l;
+        p.focus_target = q.focus_target && i == 0;
+        p.warp = Some(reborn_graphics::Warp {
+            corners: [
+                [left, q.y],
+                [right, q.y],
+                [right, q.y + q.h],
+                [left, q.y + q.h],
+            ],
+            colors: [l, r, r, l],
+        });
+        out.push(p);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn rainbow_is_periodic_and_preserves_alpha() {
+        assert_eq!(rainbow(0., 137), rainbow(1., 137));
+        assert_eq!(rainbow(0.3, 137) & 255, 137);
+        assert_ne!(rainbow(0., 255), rainbow(0.5, 255));
+    }
+    #[test]
+    fn gradient_vertices_share_one_colour_field() {
+        for phase in [0., 0.13, 0.49, 0.91] {
+            let mut c = Canvas::new();
+            c.rrect_outline(20., 40., 180., 80., 16., 3., 0xffffffcc);
+            gradient(&mut c, 0, 20., 40., 180., 80., phase);
+            assert!(c.draw.len() < 40);
+            for q in &c.draw {
+                let warp = q.warp.as_ref().expect("interpolated geometry");
+                for (corner, colour) in warp.corners.iter().zip(warp.colors) {
+                    assert_eq!(colour, rainbow(phase + (corner[0] - 20.) / 180., 204));
+                }
+                assert!(q.w > 0. && q.h > 0.);
+                if q.tex == Tex::Mask {
+                    assert!(q.src[2] > 0);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn gradient_preserves_mask_source_and_focus() {
+        let mut q = Quad::masked(Tex::Mask, [30, 40, 16, 16], 10., 20., 16., 16., 0xffffff80);
+        q.focus_target = true;
+        let mut pieces = Vec::new();
+        gradient_quad(q, 10., 16., 0.37, &mut pieces);
+        let mut x = 30;
+        for p in &pieces {
+            assert_eq!(p.src[0], x);
+            assert_eq!(p.src[1], 40);
+            assert_eq!(p.src[3], 16);
+            x += p.src[2];
+        }
+        assert_eq!(x, 46);
+        assert_eq!(pieces.iter().filter(|p| p.focus_target).count(), 1);
+        assert!(pieces.windows(2).all(
+            |p| p[0].warp.as_ref().unwrap().colors[1] == p[1].warp.as_ref().unwrap().colors[0]
+        ));
+    }
+}
