+/// Custom startup handoff: preserve the real bar and status; fade the star into the UI.
+pub fn starpop_boot_transition(ui: Vec<Quad>, remaining: f32) -> Vec<Quad> {
+    if remaining <= 0. {
+        return ui;
+    }
+    const SIDE: usize = 88;
+    const FRAME: usize = SIDE * SIDE * 3;
+    const FRAMES: &[u8] = include_bytes!("starpop_boot.rgb");
+    let t = 1. - remaining.clamp(0., 1.);
+    let chrome = 1. - smooth(t / 0.4);
+    let reveal = smooth((t - 0.2) / 0.8);
+    let mut quads = with_overlay(ui, 1. - reveal);
+    let mut c = Canvas::new();
+    // Early splash freezes on frame zero at handoff. Advance approximately every 100ms.
+    let index = ((t * 3.4).floor() as usize).min(18);
+    let pixels = &FRAMES[index * FRAME..(index + 1) * FRAME];
+    for y in 0..SIDE {
+        let mut x = 0;
+        while x < SIDE {
+            let at = (y * SIDE + x) * 3;
+            let rgb = &pixels[at..at + 3];
+            let mut end = x + 1;
+            while end < SIDE && &pixels[(y * SIDE + end) * 3..(y * SIDE + end) * 3 + 3] == rgb {
+                end += 1;
+            }
+            if rgb != [6, 7, 10] {
+                let ink = u32::from_be_bytes([rgb[0], rgb[1], rgb[2], 255]);
+                c.rect(
+                    196. + x as f32,
+                    106. + y as f32 - REVEAL_LIFT * reveal,
+                    (end - x) as f32,
+                    1.,
+                    fade(ink, 1. - reveal),
+                );
+            }
+            x = end;
+        }
+    }
+    if chrome > 0. {
+        bar(&mut c, 1., chrome);
+        status(&mut c, LABEL_Y, BOOT_FINAL_LABEL, chrome);
+    }
+    quads.extend(c.finish());
+    quads
+}
